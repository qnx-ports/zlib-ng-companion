pkgname=zlib-ng
pkgver=2.2.5
_zlib_ver=1.3.1
pkgrel=0
pkgdesc="zlib replacement with optimizations for next generation systems"
arch="all"
license="Zlib"
url="https://zlib.net/"
provides="zlib=$_zlib_ver"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/zlib-ng/zlib-ng/archive/refs/tags/$pkgver.tar.gz"

build() {
    # we trade size for a little more speed.
    export CFLAGS="$CFLAGS -O3 -fPIC"
    ./configure \
        --prefix=/usr \
        --shared \
	--zlib-compat
    make
}

check() {
    make check
}

package() {
    make install DESTDIR="$pkgdir"
}

dev() {
    default_dev

    provides="zlib-dev=$_zlib_ver"
    sed -i "s:$_zlib_ver.zlib-ng:$_zlib_ver:g" "$subpkgdir"/usr/lib/pkgconfig/zlib.pc
}

sha512sums="
b599ea24375d08fa098ed7c3b14548e0d9731a155a024a0904b0ae4a6d3491a69f0c0574d66b6e4af1e40f10e38b6b555d4c4b1fe3589ca83a5f97fbd92f635f  zlib-ng-2.2.5.tar.gz
"
